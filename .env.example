# Keystatic GitHub mode (produkcija / admin.ledtehnika.com)
# Kreiraj GitHub App: lokalno otvori /keystatic i klikni "Create GitHub App"
# ili ručno na https://github.com/settings/apps

KEYSTATIC_GITHUB_REPO=dragang1/led-tehnika
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Admin subdomena (middleware)
KEYSTATIC_ADMIN_HOST=admin.ledtehnika.com
